<mujoco model="go2 navigation scene">
  <!-- Unmodified Go2 model in a flat arena with obstacles. Start pose: origin,
       facing +x. Used by the go2_autonomy acceptance tests together with
       unitree_mujoco_nav, which adds a simulated range scanner published over DDS. -->
  <include file="go2.xml"/>

  <statistic center="2.3 -0.3 0.0" extent="4.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-60" elevation="-45" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="obstacle" rgba="0.85 0.35 0.15 1"/>
    <material name="obstacle_low" rgba="0.9 0.75 0.1 1"/>
    <material name="goal" rgba="0.1 0.9 0.2 0.35"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Obstacle 1: wall segment blocking the straight line (0,0) -> (5,0). 0.4 x 1.2 x 0.6 m -->
    <geom name="obstacle_wall" type="box" pos="2.5 0.0 0.3" size="0.2 0.6 0.3" material="obstacle"/>
    <!-- Obstacle 2: pillar, r = 0.2 m, 0.8 m tall -->
    <geom name="obstacle_pillar" type="cylinder" pos="4.0 1.1 0.4" size="0.2 0.4" material="obstacle"/>
    <!-- Obstacle 3: low box, only 0.25 m tall (below the horizontal scan layer) -->
    <geom name="obstacle_low_box" type="box" pos="3.6 -1.0 0.125" size="0.3 0.3 0.125" material="obstacle_low"/>

    <!-- Visual-only goal marker for the main scenario (no collision, not seen by the scanner). -->
    <site name="goal_marker" pos="5.0 0 0.01" size="0.15 0.01" type="cylinder" material="goal" group="1"/>
  </worldbody>
</mujoco>
